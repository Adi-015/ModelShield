# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Datasets (never commit raw CIFAR-10 data)
data/*
!data/.gitkeep
*.tar.gz
*.zip
cifar-10-batches-py/
cifar-10-python.tar.gz

# Model checkpoints & large weights (permanent weights stay in Google Drive)
checkpoints/*
!checkpoints/.gitkeep
*.pth
*.pt
*.ckpt
*.h5
*.onnx

# Generated outputs & figures (preserve folder with .gitkeep)
outputs/*
!outputs/.gitkeep
*.png
*.jpg
*.jpeg
*.svg
*.csv
*.json
!outputs/.gitkeep

# Execution Logs (preserve folder with .gitkeep)
logs/*
!logs/.gitkeep
*.log

# Personal Google Drive paths & Colab runtime artifacts
/content/drive/
MyDrive/
drive/
.colab/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Testing caches & coverage
.pytest_cache/
.coverage
htmlcov/

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Environment variables & secrets
.env*
secrets/
*.pem
*.key

# Temporary files
tmp/
temp/
